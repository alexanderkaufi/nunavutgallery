{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nunavutgallery",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "ARTWORK_CACHE",
      "bucket_name": "nunavut-gallery-artwork-cache"
    }
  ]
}
