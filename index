<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Recent Inuit art from Nunavut Gallery. View current works and descriptions through Instagram.">
  <title>Nunavut Gallery | Recent Inuit Art</title>
  <style>
    :root{--ink:#17211f;--paper:#f8f6f0;--stone:#ece9e1;--white:#fff;--red:#a3382e;--muted:#66706c;--line:#d9d5ca;--serif:Georgia,'Times New Roman',serif;--sans:Inter,ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.55}a{color:inherit}.notice{padding:.55rem 1rem;background:var(--ink);color:#fff;text-align:center;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}
    header{position:sticky;top:0;z-index:20;background:rgba(248,246,240,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}nav{max-width:1240px;min-height:74px;margin:auto;padding:0 24px;display:flex;align-items:center;gap:<>}.brand{display:flex;align-items:center;gap:11px;text-decoration:none}.mark{width:36px;height:36px;border:1px solid var(--ink);border-radius:50%;display:grid;place-items:center;font:22px var(--serif)}.brand-name{font:1.2rem var(--serif)}.nav-links{margin-left:auto;display:flex;align-items:center;gap:22px}.nav-links a{text-decoration:none;font-size:.88rem}.nav-cta{padding:.62rem .95rem;border:1px solid var(--ink)}
    .hero{max-width:1240px;margin:auto;padding:96px 24px 74px;display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:end}.eyebrow{color:var(--red);font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}h1,h2,h3{font-family:var(--serif);font-weight:400;line-height:1.08}h1{max-width:760px;margin:.6rem 0 1.3rem;font-size:clamp(3.1rem,7vw,6.2rem);letter-spacing:-.045em}.hero p{max-width:650px;color:var(--muted);font-size:1.05rem}.actions{margin-top:1.8rem;display:flex;flex-wrap:wrap;gap:12px}.btn{min-height:48px;padding:0 1.25rem;display:inline-flex;align-items:center;justify-content:center;background:var(--ink);border:1px solid var(--ink);color:#fff;text-decoration:none}.btn.alt{background:transparent;color:var(--ink)}.btn:hover,.btn:focus{background:var(--red);border-color:var(--red);color:#fff}.hero-note{padding:28px;background:var(--white);border:1px solid var(--line)}.hero-note strong{display:block;margin-bottom:8px;font:1.25rem var(--serif)}.hero-note p{margin:.45rem 0 0;font-size:.92rem}
    .service-bar{max-width:1240px;margin:auto;display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--line)}.service-bar div{padding:24px 30px;border-right:1px solid var(--line)}.service-bar div:last-child{border-right:0}.service-bar strong{display:block;font:1.05rem var(--serif)}.service-bar span{color:var(--muted);font-size:.8rem}
    .section{max-width:1240px;margin:auto;padding:92px 24px 110px}.section-head{margin-bottom:38px;display:flex;justify-content:space-between;align-items:end;gap:32px}h2{margin:.3rem 0;font-size:clamp(2.4rem,5vw,4.3rem)}.section-head p{max-width:500px;color:var(--muted)}.instagram-shell{padding:28px;background:var(--stone);border:1px solid var(--line)}.instagram-frame{max-width:680px;min-height:540px;margin:auto;display:grid;place-items:center}.instagram-media{min-width:0!important;width:100%!important;max-width:658px!important;margin:0 auto!important}.fallback{max-width:660px;margin:24px auto 0;padding:22px;background:var(--white);border:1px solid var(--line);text-align:center}.fallback strong{display:block;margin-bottom:6px;font:1.2rem var(--serif)}.availability{margin-top:28px;padding:26px;background:var(--white);border:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center}.availability h3{margin:0 0 7px;font-size:1.55rem}.availability p{margin:0;color:var(--muted)}
    .contact{background:var(--ink);color:#fff}.contact-inner{max-width:1240px;margin:auto;padding:92px 24px;display:grid;grid-template-columns:1fr 1fr;gap:80px}.contact p{max-width:600px;color:#c9cfcc}.contact .btn{background:#fff;border-color:#fff;color:var(--ink)}.contact .btn.alt{background:transparent;color:#fff}.facts{border-top:1px solid #3a4642}.fact{padding:17px 0;display:grid;grid-template-columns:110px 1fr;gap:18px;border-bottom:1px solid #3a4642}.fact span{color:#9eaaa5}
    footer{padding:32px 24px;background:#0d1412;color:#aeb8b3;font-size:.78rem}.footer-inner{max-width:1240px;margin:auto;display:flex;justify-content:space-between;gap:20px}footer a{color:#dce1de}
    @media(max-width:900px){.hero,.contact-inner{grid-template-columns:1fr;gap:34px}.service-bar{grid-template-columns:1fr}.service-bar div{border-right:0;border-bottom:1px solid var(--line)}.availability{grid-template-columns:1fr}}
    @media(max-width:640px){.nav-links a:not(.nav-cta){display:none}.hero{padding-top:62px}.section-head{display:block}.instagram-shell{padding:12px}.footer-inner{display:block}}
  </style>
</head>
<body>
  <div class="notice">Original Inuit art · Price and availability on request</div>
  <header>
    <nav aria-label="Main navigation">
      <a class="brand" href="#top"><span class="mark" aria-hidden="true">N</span><span class="brand-name">Nunavut Gallery</span></a>
      <div class="nav-links">
        <a href="#instagram">Recent works</a>
        <a href="https://www.instagram.com/nunavutgallery/" target="_blank" rel="noopener">Instagram ↗</a>
        <a class="nav-cta" href="mailto:info@nunavutgallery.com">Contact</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div>
        <span class="eyebrow">Inuit art from Canada’s North</span>
        <h1>Discover our latest works.</h1>
        <p>Nunavut Gallery presents recent Inuit sculpture, prints, drawings and textile works through its current Instagram collection. Open the Instagram account to view the latest images, descriptions and contact options.</p>
        <div class="actions">
          <a class="btn" href="#instagram">View recent works</a>
          <a class="btn alt" href="https://www.instagram.com/nunavutgallery/" target="_blank" rel="noopener">Open Instagram</a>
        </div>
      </div>
      <aside class="hero-note">
        <strong>Current collection</strong>
        <p>The Instagram account remains the current source for new works and descriptions.</p>
        <p><b>Price and availability:</b> Please contact the gallery or open the corresponding Instagram post.</p>
      </aside>
    </section>

    <section class="service-bar" aria-label="Gallery services">
      <div><strong>Current works</strong><span>New posts appear through Instagram</span></div>
      <div><strong>Personal guidance</strong><span>Ask about a specific work or artist</span></div>
      <div><strong>Shipping</strong><span>Canada and international inquiries welcome</span></div>
    </section>

    <section class="section" id="instagram">
      <div class="section-head">
        <div><span class="eyebrow">Latest from Instagram</span><h2>Recent works</h2></div>
        <p>The public Instagram account contains the current images and descriptions maintained by Nunavut Gallery.</p>
      </div>

      <div class="instagram-shell">
        <div class="instagram-frame">
          <blockquote class="instagram-media"
            data-instgrm-captioned
            data-instgrm-permalink="https://www.instagram.com/nunavutgallery/"
            data-instgrm-version="14">
            <div class="fallback">
              <strong>Nunavut Gallery on Instagram</strong>
              <p>The Instagram view is loading. Open the account directly if your browser blocks embedded Instagram content.</p>
              <a class="btn" href="https://www.instagram.com/nunavutgallery/" target="_blank" rel="noopener">View current works on Instagram</a>
            </div>
          </blockquote>
        </div>

        <div class="fallback">
          <strong>Current works and descriptions</strong>
          <p>Instagram controls the public feed. The button below always opens the current account, including its latest posts and contact options.</p>
          <a class="btn" href="https://www.instagram.com/nunavutgallery/" target="_blank" rel="noopener">Open @nunavutgallery</a>
        </div>
      </div>

      <div class="availability">
        <div>
          <h3>Price and availability on request</h3>
          <p>Availability can change. Please refer to the Instagram description or contact the gallery with the link or a screenshot of the work.</p>
        </div>
        <a class="btn" href="mailto:info@nunavutgallery.com?subject=Artwork%20inquiry">Ask the gallery</a>
      </div>
    </section>

    <section class="contact">
      <div class="contact-inner">
        <div>
          <span class="eyebrow">Contact</span>
          <h2>Ask about a work.</h2>
          <p>Send the Instagram link or a screenshot of the work. The gallery will confirm its current availability, price and further details.</p>
          <div class="actions">
            <a class="btn" href="mailto:info@nunavutgallery.com?subject=Artwork%20inquiry">Email the gallery</a>
            <a class="btn alt" href="https://www.instagram.com/nunavutgallery/" target="_blank" rel="noopener">View Instagram</a>
          </div>
        </div>
        <div class="facts">
          <div class="fact"><span>Gallery</span><strong>Nunavut Gallery</strong></div>
          <div class="fact"><span>Director</span><strong>Richard Kroeker</strong></div>
          <div class="fact"><span>Location</span><strong>Winnipeg, Manitoba, Canada</strong></div>
          <div class="fact"><span>Instagram</span><strong>@nunavutgallery</strong></div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-inner">
      <span>© <span id="year"></span> Nunavut Gallery</span>
      <a href="https://www.instagram.com/nunavutgallery/" target="_blank" rel="noopener">@nunavutgallery</a>
    </div>
  </footer>

  <script async src="https://www.instagram.com/embed.js"></script>
  <script>
    document.querySelector("#year").textContent = new Date().getFullYear();
    window.addEventListener("load", () => {
      if (window.instgrm && window.instgrm.Embeds) window.instgrm.Embeds.process();
    });
  </script>
</body>
</html>
